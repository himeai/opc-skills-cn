{
  "$schema": "https://example.invalid/opc-skills-cn/claude-plugin-marketplace.schema.json",
  "name": "opc-skills-cn",
  "displayName": "opc-skills-cn",
  "description": "面向中国市场的一人公司 AI Agent Skills 集合。",
  "version": "0.0.1",
  "author": "opc-skills-cn contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/<YOUR_ORG>/opc-skills-cn",
  "repository": "https://github.com/<YOUR_ORG>/opc-skills-cn",
  "_comment": {
    "skills": "Claude Code 插件 marketplace 的 skill 条目数组；每项应与 skills.json 和 skills/<name>/ 目录保持一致。"
  },
  "skills": [
    {
      "name": "cn-city-picker",
      "displayName": "中国创业城市选址",
      "description": "根据行业、预算、家庭、户籍、生活偏好，从中国重点城市中按八维评分筛选 Top 3-5 推荐城市。",
      "version": "0.1.0",
      "path": "skills/cn-city-picker",
      "logo": "skill-logos/cn-city-picker.svg",
      "color": "#2E7CF6",
      "commands": [
        "python3 scripts/pick.py \"{input}\"",
        "python3 scripts/profile.py \"{input}\"",
        "python3 scripts/compare.py {input}"
      ],
      "triggers": ["选城市", "创业去哪", "城市对比", "跨境电商", "数字游民", "惠州", "大理"]
    },
    {
      "name": "wechat-ops",
      "displayName": "微信公众号运营",
      "description": "微信公众号 access_token 缓存、图文草稿、自定义菜单、客服文本回复，仅调用公众平台官方开放 API。",
      "version": "0.1.0",
      "path": "skills/wechat-ops",
      "logo": "skill-logos/wechat-ops.svg",
      "color": "#07C160",
      "commands": [
        "python3 scripts/mp_token.py",
        "python3 scripts/publish.py \"{input}\"",
        "python3 scripts/menu.py \"{input}\"",
        "python3 scripts/reply.py \"{input}\""
      ],
      "triggers": ["公众号", "推文", "图文消息", "菜单", "客服回复", "草稿", "订阅号", "服务号"]
    }
  ]
}
